# ==============================================================================
# SHEHATA DRIVE - 4 vCPU / 8 GB RAM VPS CONFIGURATION
# ==============================================================================

# Domain / Host Configuration
# For local testing use: localhost
# For production VPS use your domain: drive.yourdomain.com
DRIVE_DOMAIN=localhost
DRIVE_PROTOCOL=http
DRIVE_PORT=8080
AUDIT_PORT=8090

# Nextcloud Admin Account
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=ChangeMe_StrongAdminPass_2026!

# PostgreSQL Database Credentials
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=ChangeMe_StrongPostgresPass_2026!

# Redis Cache & File Locking Password
REDIS_PASSWORD=ChangeMe_StrongRedisPass_2026!

# Collabora Online (Nextcloud Office) Admin Credentials
COLLABORA_ADMIN_USER=collabora_admin
COLLABORA_ADMIN_PASSWORD=ChangeMe_CollaboraPass_2026!
# Escape dots for regex domain matching in Collabora (e.g., drive\.yourdomain\.com)
COLLABORA_DICTIONARIES=en_US ar

# Audit Dashboard Credentials & Settings
AUDIT_ADMIN_USER=admin
AUDIT_ADMIN_PASSWORD=ChangeMe_StrongAdminPass_2026!
AUDIT_ADMIN_TOKEN=shehata-audit-secret-2026
AUDIT_MASS_DELETE_THRESHOLD=15
AUDIT_RETENTION_DAYS=365
WEBHOOK_ALERT_URL=

# Timezone
TZ=Africa/Cairo
